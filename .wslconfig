[wsl2]
# Memory allocation (in GB) - system has 7.6GB total, 3.1GB available
memory=6GB

# Number of processors to use - system has 16 cores, leave 2-4 for Windows
processors=12

# Swap file size (in GB) - system currently has 2GB
swap=2GB

# Enable nested virtualization (useful for Docker)
nestedVirtualization=true

# Turn off auto-generation of /etc/hosts (prevents duplicate entries)
generateHosts=false

# Enable systemd (required for modern Linux services)
systemd=true

# Auto-mount Windows drives with metadata
[automount]
enabled=true
options="metadata,umask=22,fmask=11"
mountFsTab=false

# Network settings
[network]
generateResolvConf=false
